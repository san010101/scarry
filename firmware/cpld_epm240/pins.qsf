set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM240T100C5
set_global_assignment -name TOP_LEVEL_ENTITY alf_cartridge_top
set_global_assignment -name VERILOG_FILE alf_cartridge_top.v
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# Тактирование 50 МГц и сигнал режима MCU
set_location_assignment PIN_12 -to clk_50m
set_location_assignment PIN_14 -to mcu_active

# Интерфейс SPI0 к Raspberry Pi Pico (A1)
set_location_assignment PIN_15 -to spi_cs_n
set_location_assignment PIN_16 -to spi_sck
set_location_assignment PIN_17 -to spi_mosi
set_location_assignment PIN_18 -to spi_miso

# Входы адреса Z80 A0..A13 (от буферов U2, U3)
set_location_assignment PIN_1  -to z80_a[0]
set_location_assignment PIN_2  -to z80_a[1]
set_location_assignment PIN_3  -to z80_a[2]
set_location_assignment PIN_4  -to z80_a[3]
set_location_assignment PIN_5  -to z80_a[4]
set_location_assignment PIN_6  -to z80_a[5]
set_location_assignment PIN_7  -to z80_a[6]
set_location_assignment PIN_8  -to z80_a[7]
set_location_assignment PIN_19 -to z80_a[8]
set_location_assignment PIN_20 -to z80_a[9]
set_location_assignment PIN_21 -to z80_a[10]
set_location_assignment PIN_26 -to z80_a[11]
set_location_assignment PIN_27 -to z80_a[12]
set_location_assignment PIN_28 -to z80_a[13]

# Управляющие сигналы Z80 (от буферов U3, U4)
set_location_assignment PIN_29 -to pbank_33v
set_location_assignment PIN_30 -to romc_n_33v
set_location_assignment PIN_33 -to z80_rst_n

# Управление буфером шины данных U5 (74LVT245)
set_location_assignment PIN_34 -to buf_dir
set_location_assignment PIN_35 -to buf_oe_n

# Шина данных SRAM /D0_33V .. /D7_33V (8 линий)
set_location_assignment PIN_36 -to sram_d[0]
set_location_assignment PIN_37 -to sram_d[1]
set_location_assignment PIN_38 -to sram_d[2]
set_location_assignment PIN_39 -to sram_d[3]
set_location_assignment PIN_40 -to sram_d[4]
set_location_assignment PIN_41 -to sram_d[5]
set_location_assignment PIN_42 -to sram_d[6]
set_location_assignment PIN_43 -to sram_d[7]

# Шина адреса SRAM /SRAM_A0 .. /SRAM_A18 (19 линий)
set_location_assignment PIN_47 -to sram_a[0]
set_location_assignment PIN_48 -to sram_a[1]
set_location_assignment PIN_49 -to sram_a[2]
set_location_assignment PIN_50 -to sram_a[3]
set_location_assignment PIN_51 -to sram_a[4]
set_location_assignment PIN_52 -to sram_a[5]
set_location_assignment PIN_53 -to sram_a[6]
set_location_assignment PIN_54 -to sram_a[7]
set_location_assignment PIN_55 -to sram_a[8]
set_location_assignment PIN_56 -to sram_a[9]
set_location_assignment PIN_57 -to sram_a[10]
set_location_assignment PIN_58 -to sram_a[11]
set_location_assignment PIN_61 -to sram_a[12]
set_location_assignment PIN_66 -to sram_a[13]
set_location_assignment PIN_67 -to sram_a[14]
set_location_assignment PIN_68 -to sram_a[15]
set_location_assignment PIN_69 -to sram_a[16]
set_location_assignment PIN_70 -to sram_a[17]
set_location_assignment PIN_71 -to sram_a[18]

# Управляющие линии SRAM U6 (AS6C4008)
set_location_assignment PIN_72 -to sram_ce_n
set_location_assignment PIN_73 -to sram_oe_n
set_location_assignment PIN_74 -to sram_we_n
